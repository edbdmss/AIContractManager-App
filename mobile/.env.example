# 웹 개발 서버
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api/aicontract
# Android 에뮬레이터: http://10.0.2.2:8080/api/aicontract
# 실제 휴대폰 / 배포: 휴대폰에서 접근 가능한 HTTPS 서버 주소

# 웹 로그인 복귀 주소 (생략 시 현재 웹 origin/oauth/callback)
# EXPO_PUBLIC_OAUTH_REDIRECT_URI=http://localhost:8081/oauth/callback

# 설치형 앱 로그인: 이 프로젝트의 웹 callback 페이지를 HTTPS로 호스팅합니다.
# EXPO_PUBLIC_NATIVE_OAUTH_REDIRECT_URI=https://YOUR_FRONTEND_HOST/oauth/native-callback

# 실제 서비스 정책 페이지가 준비되면 설정합니다.
# EXPO_PUBLIC_TERMS_URL=https://YOUR_FRONTEND_HOST/terms
# EXPO_PUBLIC_PRIVACY_URL=https://YOUR_FRONTEND_HOST/privacy
# 비밀번호, client secret, JWT 서명키를 여기에 넣지 마세요.
