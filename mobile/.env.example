# 실제 서버 연결 (API 기본 경로는 /api/aicontract)
# 웹: http://localhost:8080/api/aicontract
# Android 에뮬레이터: http://10.0.2.2:8080/api/aicontract
# 실제 휴대폰: 같은 Wi-Fi에 연결하고 localhost 대신 컴퓨터의 LAN IP 사용
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api/aicontract

# 제공자 콘솔에 등록한 로그인 복귀 주소와 정확히 일치해야 합니다.
# 웹 기본값: http://localhost:8081/oauth/callback
# 개발/배포 앱 기본값: contractmanager://oauth/callback
# 제공자가 custom scheme을 허용하지 않으면 HTTPS 복귀 페이지 또는 네이티브 SDK 설계가 필요합니다.
# EXPO_PUBLIC_OAUTH_REDIRECT_URI=http://localhost:8081/oauth/callback
